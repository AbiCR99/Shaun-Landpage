---
import '@fontsource-variable/unbounded/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
// Preload only the display font's latin subset: it's what the hero needs first.
import unboundedLatin from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { languages, useTranslations, type Lang } from '../i18n/utils';
import { site as siteData, socials } from '../data/site';

interface Props {
  lang: Lang;
  /** Overrides the page title (defaults to the site title). */
  title?: string;
  /** Pages that shouldn't be indexed (404): no canonical/hreflang, robots noindex. */
  noindex?: boolean;
}

const { lang, title, noindex = false } = Astro.props;
const t = useTranslations(lang);
const canonical = getAbsoluteLocaleUrl(lang, '');
const ogLocale = lang === 'es' ? 'es_AR' : 'en_US';
// Absolute URL: WhatsApp, Instagram and others ignore relative og:image paths.
const ogImage = new URL('/og.png', Astro.site).href;

// Structured data for search engines. MusicGroup (not Person): schema.org defines it for solo
// musicians too, and it has `genre`. Only confirmed facts: no releases, supports or anything "TO CONFIRM".
const sameAs = socials.flatMap((s) => (s.url ? [s.url] : []));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: siteData.name,
  url: getAbsoluteLocaleUrl('en', ''),
  description: t.meta.description,
  genre: 'Progressive house',
  location: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: 'La Falda', addressRegion: 'Córdoba', addressCountry: 'AR' },
  },
  ...(sameAs.length > 0 && { sameAs }),
};
// Escape "<" so the JSON can never close the <script> tag early.
const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#070D18" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={unboundedLatin} as="font" type="font/woff2" crossorigin />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {Object.keys(languages).map((l) => (
            <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, '')} />
          ))}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', '')} />
        </>
      )
    }

    <!-- Open Graph: how the link looks when shared on WhatsApp / Instagram. Image: `npm run og`. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shaun Nolanh" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <slot />
    <script>
      import { revealFallback } from '../scripts/reveal';
      revealFallback('.section__title');
    </script>
  </body>
</html>
