---
import ContactForm from './ContactForm.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="collabs" aria-labelledby="collabs-title">
  <div class="container collabs">
    <header class="section__head">
      <h2 class="section__title" id="collabs-title">{t.collabs.title}</h2>
      <p class="section__lead">{t.collabs.lead}</p>
    </header>

    <ContactForm lang={lang} variant="collab" glow />
  </div>
</section>

<style>
  .collabs {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 64rem) {
    .collabs {
      grid-template-columns: 1fr 1.4fr;
      align-items: start;
    }
  }
</style>
