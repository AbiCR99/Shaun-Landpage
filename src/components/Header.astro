---
import LangSwitch from './LangSwitch.astro';
import { homePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  { href: '#music', label: t.nav.music },
  { href: '#sets', label: t.nav.sets },
  { href: '#about', label: t.nav.about },
  { href: '#booking', label: t.nav.booking },
  { href: '#collabs', label: t.nav.collabs },
];
---

<header class="header">
  <div class="header__bar container">
    <a class="header__logo" href={homePath(lang)}>Shaun Nolanh</a>

    <nav class="header__nav" id="site-nav" aria-label={t.nav.label}>
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__tools">
      <LangSwitch lang={lang} />
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-label-open={t.nav.menuOpen}
        data-label-close={t.nav.menuClose}
      >
        <span class="visually-hidden">{t.nav.menuOpen}</span>
        <span class="header__burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu, active section and hide-on-scroll. Without JS the nav is still reachable
  // because the anchors still work and the footer repeats the language switch.
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = header?.querySelector<HTMLElement>('.header__nav');

  if (header && toggle && nav) {
    header.dataset.js = 'true';
    const label = toggle.querySelector('.visually-hidden')!;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
      header.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Active section: the link of the section crossing the middle of the viewport gets aria-current.
    const links = new Map(
      [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((a) => [a.hash.slice(1), a]),
    );
    const sections = [...links.keys()].flatMap((id) => document.getElementById(id) ?? []);
    if ('IntersectionObserver' in window) {
      // Sections touching a thin band around the middle of the viewport. If two touch it at a boundary,
      // the later one in the page wins (it's the one being scrolled into), so only one link is ever marked.
      const inBand = new Set<Element>();
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) inBand.add(entry.target);
            else inBand.delete(entry.target);
          }
          const active = sections.filter((section) => inBand.has(section)).at(-1);
          for (const section of sections) {
            const link = links.get(section.id);
            if (section === active) link?.setAttribute('aria-current', 'true');
            else link?.removeAttribute('aria-current');
          }
        },
        { rootMargin: '-47% 0px -52% 0px' },
      );
      sections.forEach((section) => sectionObserver.observe(section));
    }

    // Hide on scroll down, show on scroll up, only past the hero. Never while the mobile menu is open,
    // while focus is inside the header, or with reduced motion.
    const hero = document.querySelector<HTMLElement>('.hero');
    if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let lastY = window.scrollY;
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = window.scrollY;
        const pastHero = y > hero.offsetTop + hero.offsetHeight;
        const locked = header.hasAttribute('data-open') || header.matches(':focus-within');
        if (!pastHero || locked || y < lastY - 4) header.removeAttribute('data-hidden');
        else if (y > lastY + 4) header.setAttribute('data-hidden', '');
        lastY = y;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      // Tabbing into a hidden header brings it back
      header.addEventListener('focusin', () => header.removeAttribute('data-hidden'));
    }
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--night-950) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--blue-600) 35%, transparent);
    transition: transform 0.5s var(--ease-slow);
  }

  .header[data-hidden] {
    transform: translateY(-100%);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: 3.5rem;
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .header__nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fog-300);
    transition: color 0.3s var(--ease-slow);
  }

  .header__nav a:hover,
  .header__nav a[aria-current='true'] {
    color: var(--moon-100);
  }

  /* Active section: a thin --blue-400 line under the link (not orange: the light stays in the content) */
  .header__nav a {
    position: relative;
  }

  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.4rem;
    height: 1px;
    background: var(--blue-400);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s var(--ease-slow);
  }

  .header__nav a[aria-current='true']::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__nav a::after {
      transition: none;
    }
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .header__burger,
  .header__burger::before {
    display: block;
    width: 1.4rem;
    height: 1px;
    margin-inline: auto;
    background: var(--moon-100);
    transition: transform 0.3s var(--ease-slow);
  }

  .header__burger {
    transform: translateY(-4px);
  }

  .header__burger::before {
    content: '';
    transform: translateY(8px);
  }

  [data-open] .header__burger {
    transform: rotate(45deg);
  }

  [data-open] .header__burger::before {
    transform: rotate(-90deg);
  }

  /* Mobile: collapse the nav behind the toggle (only when JS is running). */
  @media (max-width: 47.99rem) {
    .header[data-js] .header__toggle {
      display: block;
    }

    .header[data-js] .header__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      height: calc(100svh - 3.5rem);
      padding: var(--space-l) var(--gutter);
      background: var(--night-950);
    }

    .header[data-js][data-open] .header__nav {
      display: block;
    }

    .header[data-js] .header__nav ul {
      flex-direction: column;
      gap: var(--space-m);
    }

    .header[data-js] .header__nav a {
      font-family: var(--font-display);
      font-size: var(--step-2);
      text-transform: uppercase;
      color: var(--moon-100);
    }

    /* Without JS: hide the inline nav to avoid overflow; the footer and the anchors still work. */
    .header:not([data-js]) .header__nav {
      display: none;
    }
  }
</style>
