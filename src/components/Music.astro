---
import SpotifyPlayer from './SpotifyPlayer.astro';
import TrackCarousel from './TrackCarousel.astro';
import { beatportProfile, releases } from '../data/music';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="music" aria-labelledby="music-title">
  <div class="container music">
    <header class="section__head">
      <h2 class="section__title" id="music-title">{t.music.title}</h2>
      <p class="section__lead">{t.music.lead}</p>
    </header>

    <div class="music__tracks">
      <TrackCarousel lang={lang} />
      <SpotifyPlayer lang={lang} />
    </div>

    <h3 class="music__subtitle">{t.music.releases}</h3>
    <ul class="releases">
      {
        releases.map((r, i) => (
          <li class="release" style={`--i: ${i}`}>
            <div class="release__main">
              <p class="release__title">
                {r.title && r.url ? (
                  <a href={r.url} target="_blank" rel="noopener">
                    {r.title}
                    <span class="visually-hidden"> {r.url.includes('spotify.com') ? t.music.onSpotify : t.music.onBeatport}</span>
                  </a>
                ) : (
                  (r.title ?? <span class="pending">[RELEASE PENDIENTE]</span>)
                )}
              </p>
              <p class="release__artists">{r.artists ?? <span class="pending">[ARTISTAS PENDIENTES]</span>}</p>
            </div>
            <div class="release__meta">
              {r.type === 'remix' && <span class="pill">{t.music.remix}</span>}
              {r.upcoming && <span class="pill">{t.music.upcoming}</span>}
              <span class="mono">{r.label ?? <span class="pending">[SELLO]</span>}</span>
              <span class="mono">{r.year ?? <span class="pending">[AÑO]</span>}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="releases__all mono" href={beatportProfile} target="_blank" rel="noopener">
      {t.music.allOnBeatport} <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<script>
  // Time-based cascade, so it runs on IntersectionObserver in every browser (scroll timelines have no milliseconds).
  import { reveal } from '../scripts/reveal';
  reveal('.release');
</script>

<style>
  /* In front of the hand scene (MusicScene, z-index 1): the cigarette falls behind the header and the covers.
     z-index on the children only. No `isolation` on .music: the scene blends with the page itself. */
  .music :global(.section__head),
  .music__tracks {
    position: relative;
    z-index: 2;
  }

  .music__tracks {
    margin-bottom: var(--space-xl);
  }

  .music__subtitle {
    margin-bottom: var(--space-m);
    font-size: var(--step-1);
    text-transform: uppercase;
  }

  .releases {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--blue-600);
  }

  .release {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--blue-600);
  }

  /* Cascade: hidden only once JS has added data-reveal; 80ms between rows, capped at 400ms */
  .release[data-reveal] {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  /* The transition lives on the visible state: hiding is instant (no fade-out on load), showing is animated */
  .release[data-reveal].is-visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s var(--ease-slow),
      transform 0.9s var(--ease-slow);
    transition-delay: min(calc(var(--i) * 80ms), 400ms);
  }

  /* A --blue-400 line draws itself left to right under the row on hover / keyboard focus inside it */
  .release::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--blue-400);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s var(--ease-slow);
  }

  .release:hover::after,
  .release:focus-within::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .release::after {
      transition: none;
    }
  }

  .release__title {
    font-weight: 700;
  }

  .release__title a {
    text-decoration: none;
  }

  .release__title a:hover {
    color: var(--moon-100);
  }

  .releases__all {
    display: inline-block;
    margin-top: var(--space-m);
    padding-block: 0.5rem;
    color: var(--fog-300);
    text-transform: uppercase;
    text-underline-offset: 0.25em;
  }

  .releases__all:hover {
    color: var(--moon-100);
  }

  .release__artists {
    color: var(--fog-300);
  }

  .release__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    color: var(--fog-300);
  }

  @media (min-width: 48rem) {
    .release {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
