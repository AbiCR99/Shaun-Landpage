---
import { homePath, languages, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<ul class="lang" aria-label={t.nav.language}>
  {
    (Object.keys(languages) as Lang[]).map((l) => (
      <li>
        <a href={homePath(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
          {languages[l]}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lang {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
  }

  a {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--fog-300);
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  a:hover {
    color: var(--moon-100);
  }

  a[aria-current='true'] {
    color: var(--moon-100);
    box-shadow: inset 0 0 0 1px var(--blue-600);
  }
</style>
