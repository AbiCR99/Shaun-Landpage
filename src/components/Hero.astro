---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__fog" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content container">
    <h1 class="hero__title" id="hero-title">
      <span>Shaun</span>
      <span>Nolanh</span>
    </h1>
    <p class="hero__tagline mono">{t.hero.tagline}</p>
  </div>
</section>

<style>
  /* Just the name and the tagline: the hand scene (MusicScene, right after the hero) fills the space
     below them and drops the cigarette into the Music carousel. */
  .hero {
    position: relative;
    padding-block: var(--space-l);
    overflow: hidden;
    isolation: isolate;
  }

  /* Atmosphere: slow blue fog drifting like a long progressive breakdown */
  .hero__fog {
    position: absolute;
    inset: -20%;
    z-index: -2;
    background:
      radial-gradient(40% 35% at 25% 30%, color-mix(in srgb, var(--blue-400) 22%, transparent), transparent 70%),
      radial-gradient(45% 40% at 80% 20%, color-mix(in srgb, var(--dusk-500) 45%, transparent), transparent 70%),
      linear-gradient(180deg, var(--night-900), var(--night-950) 75%);
    animation: drift 60s ease-in-out infinite alternate;
  }

  /* A cold, moonlit glow on the horizon: blue, so the cigarette's ember stays the hero's only orange light */
  .hero__glow {
    position: absolute;
    inset: auto -10% -35% -10%;
    height: 70%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 100%, color-mix(in srgb, var(--blue-400) 22%, transparent), color-mix(in srgb, var(--dusk-500) 18%, transparent) 55%, transparent 75%);
    pointer-events: none;
  }

  @keyframes drift {
    to {
      transform: translate3d(6%, 4%, 0) scale(1.08);
    }
  }

  .hero__content {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .hero__title {
    display: grid;
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transform-origin: left center;
    transition: text-shadow 0.6s var(--ease-slow);
    /* Comes out of the smoke once on load (keyframes in global.css). Never from opacity 0, so LCP isn't delayed. */
    animation: smoke-focus 1.6s var(--ease-slow) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title {
      animation: none;
    }
  }

  /* Chromatic aberration: only on the name, only on hover */
  .hero__title:hover {
    text-shadow:
      -0.03em 0 color-mix(in srgb, var(--ember-600) 75%, transparent),
      0.03em 0 color-mix(in srgb, var(--blue-400) 75%, transparent);
  }

  .hero__tagline {
    font-size: var(--step--1);
    text-transform: uppercase;
    color: var(--fog-300);
  }
</style>
