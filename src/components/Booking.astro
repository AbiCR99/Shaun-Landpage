---
import ContactForm from './ContactForm.astro';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section--alt" id="booking" aria-labelledby="booking-title">
  <div class="container booking">
    <header class="section__head">
      <h2 class="section__title" id="booking-title">{t.booking.title}</h2>
      <p class="section__lead">{t.booking.lead}</p>
      <div class="booking__kit">
        {
          site.pressKitUrl ? (
            <a class="btn btn--glow" href={site.pressKitUrl} download>
              {t.booking.pressKit} <span aria-hidden="true">↓</span>
            </a>
          ) : (
            <>
              <button class="btn btn--glow" type="button" disabled>{t.booking.pressKitPending}</button>
              <span class="pending">[PDF PENDIENTE]</span>
            </>
          )
        }
      </div>
      <p class="booking__email">
        <span class="mono">{t.booking.emailLabel}</span>
        <ObfuscatedEmail email={site.bookingEmail} />
      </p>
    </header>

    <ContactForm lang={lang} variant="booking" />
  </div>
</section>

<style>
  .booking {
    display: grid;
    gap: var(--space-l);
  }

  .booking__kit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  .booking__email {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: baseline;
    color: var(--fog-300);
  }

  @media (min-width: 64rem) {
    .booking {
      grid-template-columns: 1fr 1.4fr;
      align-items: start;
    }
  }
</style>
