---
// Contact form backed by Web3Forms (no backend of our own).
// Works without JS (regular POST); with JS it sends via fetch and shows the status inline.
// Antispam: Web3Forms' `botcheck` honeypot, which bots fill in and humans never see.
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  variant: 'booking' | 'collab';
  glow?: boolean;
}

const { lang, variant, glow = false } = Astro.props;
const t = useTranslations(lang);
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const id = (name: string) => `${variant}-${name}`;

type Field = {
  name: string;
  label: string;
  type: 'text' | 'email' | 'url' | 'date' | 'textarea';
  required: boolean;
  autocomplete?: 'name' | 'email';
};
const fields: Field[] =
  variant === 'booking'
    ? [
        { name: 'name', label: t.form.name, type: 'text', required: true, autocomplete: 'name' },
        { name: 'email', label: t.form.email, type: 'email', required: true, autocomplete: 'email' },
        { name: 'date', label: t.form.date, type: 'date', required: false },
        { name: 'venue', label: t.form.venue, type: 'text', required: true },
        { name: 'message', label: t.form.message, type: 'textarea', required: true },
      ]
    : [
        { name: 'name', label: t.form.name, type: 'text', required: true, autocomplete: 'name' },
        { name: 'email', label: t.form.email, type: 'email', required: true, autocomplete: 'email' },
        { name: 'music_link', label: t.form.musicLink, type: 'url', required: true },
        { name: 'proposal', label: t.form.proposal, type: 'textarea', required: true },
      ];
---

<form
  class="form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-contact-form
  data-sending={t.form.sending}
  data-success={t.form.success}
  data-error={t.form.error}
>
  <input type="hidden" name="access_key" value={accessKey ?? ''} />
  <input type="hidden" name="subject" value={variant === 'booking' ? t.form.subjectBooking : t.form.subjectCollab} />
  <input type="hidden" name="from_name" value="Shaun Nolanh site" />
  <input type="checkbox" name="botcheck" class="form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

  {
    fields.map((f) => (
      <div class:list={['form__field', f.type === 'textarea' && 'form__field--wide']}>
        <label for={id(f.name)}>
          {f.label}
          {f.required && <span aria-hidden="true"> *</span>}
        </label>
        {f.type === 'textarea' ? (
          <textarea id={id(f.name)} name={f.name} rows="5" required={f.required} />
        ) : (
          <input id={id(f.name)} name={f.name} type={f.type} required={f.required} autocomplete={f.autocomplete} />
        )}
      </div>
    ))
  }

  <div class="form__footer">
    <button class:list={['btn', glow && 'btn--glow']} type="submit" disabled={!accessKey}>
      {variant === 'booking' ? t.form.sendBooking : t.form.sendCollab}
    </button>
    {!accessKey && <p class="pending">{t.form.notConfigured}</p>}
    <p class="form__status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  // A brief spark burst from the submit button on success: momentary feedback, not a lasting light.
  // A temporary fixed canvas over the button (no layout impact), removed after ~700ms.
  function sparkBurst(origin: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const rect = origin.getBoundingClientRect();
    const size = { w: 260, h: 180 };
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    canvas.width = size.w * dpr;
    canvas.height = size.h * dpr;
    Object.assign(canvas.style, {
      position: 'fixed',
      left: `${rect.left + rect.width / 2 - size.w / 2}px`,
      // Centered on the button's top edge, so the sparks fly over the page, not over the orange button
      top: `${rect.top - size.h / 2}px`,
      width: `${size.w}px`,
      height: `${size.h}px`,
      pointerEvents: 'none',
      zIndex: '60',
    });
    document.body.append(canvas);
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);

    const root = getComputedStyle(document.documentElement);
    const colors = [root.getPropertyValue('--glow-400').trim(), root.getPropertyValue('--ember-600').trim()];
    // 12 sparks, mostly upwards, slightly random
    const sparks = Array.from({ length: 12 }, (_, i) => {
      const angle = -Math.PI / 2 + (i / 11 - 0.5) * Math.PI * 1.1 + (Math.random() - 0.5) * 0.3;
      const speed = 140 + Math.random() * 130;
      return { x: size.w / 2, y: size.h / 2, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, color: colors[i % 2] };
    });

    const duration = 700;
    let start: number | null = null;
    let last = 0;
    const frame = (now: number) => {
      start ??= now;
      const t = now - start;
      const dt = last ? (now - last) / 1000 : 0;
      last = now;
      ctx.clearRect(0, 0, size.w, size.h);
      const life = 1 - t / duration;
      for (const s of sparks) {
        s.vy += 260 * dt; // gravity
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        ctx.globalAlpha = Math.max(0, life);
        ctx.strokeStyle = s.color;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(s.x - s.vx * 0.05, s.y - s.vy * 0.05); // short streak, like the footer sparks
        ctx.stroke();
      }
      if (t < duration) requestAnimationFrame(frame);
      else canvas.remove();
    };
    requestAnimationFrame(frame);
  }

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.textContent = form.dataset.sending!;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message);
        status.textContent = form.dataset.success!;
        sparkBurst(button);
        form.reset();
      } catch {
        status.textContent = form.dataset.error!;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .form {
    display: grid;
    gap: var(--space-m);
  }

  .form__honeypot {
    display: none;
  }

  .form__field {
    display: grid;
    gap: var(--space-xs);
  }

  label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fog-300);
  }

  input,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--blue-600);
    border-radius: var(--radius);
    background: var(--night-950);
    color: var(--moon-100);
    transition: border-color 0.3s var(--ease-slow);
  }

  textarea {
    resize: vertical;
  }

  input:hover,
  textarea:hover {
    border-color: var(--blue-400);
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--glow-500);
    outline-offset: 0;
  }

  .form__footer {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .form__status:empty {
    display: none;
  }

  @media (min-width: 48rem) {
    .form {
      grid-template-columns: 1fr 1fr;
    }

    .form__field--wide,
    .form__footer {
      grid-column: 1 / -1;
    }
  }
</style>
