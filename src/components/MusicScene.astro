---
// Decorative scene between the hero and Music: the hand sits under the name and tagline, and drops
// the cigarette behind the Music carousel as you scroll. Its ember is the hero's orange light.
// It only moves forward and happens once per visit: when it ends, the hand stays empty
// (also when scrolling back up). Frames come from `npm run media` (scripts/make-media.sh).

const FRAMES = 60;
// Frame (0-based) where the ember reaches the top of the covers and goes behind them, per crop:
// from here on, the Spotify play button takes the light.
const EXIT_FRAME = { desktop: 46, mobile: 48 };
// Frame sizes (px): the canvas never draws larger than this, to avoid upscaling blur.
const SIZE = { desktop: [900, 620], mobile: [480, 600] };
---

<!-- Zero-height bridge right after the hero: the scene hangs from it, up into the hero and down into Music. -->
<div class="bridge container" aria-hidden="true">
<div
  class="scene"
  data-music-scene
  data-frames={FRAMES}
  data-exit-desktop={EXIT_FRAME.desktop}
  data-exit-mobile={EXIT_FRAME.mobile}
  data-width-desktop={SIZE.desktop[0]}
  data-width-mobile={SIZE.mobile[0]}
>
  <!-- Default (no JS / reduced motion): the end of the story, the empty hand. -->
  <picture>
    <source media="(max-width: 767px)" srcset="/media/music/mobile/empty.webp" width={SIZE.mobile[0]} height={SIZE.mobile[1]} />
    <img src="/media/music/desktop/empty.webp" width={SIZE.desktop[0]} height={SIZE.desktop[1]} alt="" loading="lazy" />
  </picture>
  <canvas></canvas>
</div>
</div>

<script>
  const scene = document.querySelector<HTMLElement>('[data-music-scene]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && !reduceMotion) {
    const canvas = scene.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const total = Number(scene.dataset.frames);
    const desktop = matchMedia('(min-width: 768px)');
    // The featured player's play button is Music's single light. It may not exist yet
    // (pending embed): then there's simply nothing to light up.
    // Explicit hook (set by the Spotify player facade in Music) instead of a class selector.
    const play = document.querySelector<HTMLElement>('[data-music-light]');

    let frames: HTMLImageElement[] = [];
    let empty: HTMLImageElement;
    let maxProgress = 0;
    let done = false;
    let drawn: HTMLImageElement | null = null;
    let ticking = false;

    const setName = () => (desktop.matches ? 'desktop' : 'mobile');
    const exitFrame = () => Number(desktop.matches ? scene.dataset.exitDesktop : scene.dataset.exitMobile);
    const url = (name: string) => `/media/music/${setName()}/${name}.webp`;

    function image(src: string) {
      const img = new Image();
      img.src = src;
      // decode() prepares the bitmap off the main thread, so drawing it later never stalls the scroll.
      img.decode().then(requestRender, () => {});
      return img;
    }

    // First frame and end frame load right away (two small files); the rest on first intent.
    function loadEnds() {
      drawn = null;
      frames = new Array(total);
      frames[0] = image(url('f001'));
      empty = image(url('empty'));
    }

    function loadAll() {
      for (let i = 1; i < total; i++) frames[i] ??= image(url(`f${String(i + 1).padStart(3, '0')}`));
    }

    const isReady = (img?: HTMLImageElement) => !!img && img.complete && img.naturalWidth > 0;

    // Closest frame that has already loaded, so fast scrolling never shows a blank canvas.
    function nearestLoaded(target: number) {
      for (let d = 0; d < total; d++) {
        for (const i of [target - d, target + d]) if (isReady(frames[i])) return frames[i];
      }
      return null;
    }

    // The scene is already on screen at load: 0 with the page at the top, 1 when the covers' center
    // reaches 55% of the viewport (the cigarette has gone behind them by then).
    const cover = document.querySelector<HTMLElement>('[data-carousel] .cf__slide');
    function progress() {
      if (!cover) return 1;
      const vh = window.innerHeight;
      const box = cover.getBoundingClientRect();
      const end = box.top + window.scrollY + box.height / 2 - 0.55 * vh;
      return window.scrollY / Math.max(end, 0.25 * vh);
    }

    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      const frameWidth = Number(desktop.matches ? scene!.dataset.widthDesktop : scene!.dataset.widthMobile);
      const width = Math.min(Math.round(canvas.clientWidth * dpr), frameWidth);
      canvas.width = width;
      canvas.height = Math.round(width * (canvas.clientHeight / canvas.clientWidth));
      drawn = null;
    }

    function draw(img: HTMLImageElement) {
      if (img === drawn) return;
      // Same math as `object-fit: cover`
      const scale = Math.max(canvas.width / img.naturalWidth, canvas.height / img.naturalHeight);
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h);
      drawn = img;
    }

    function finish() {
      done = true;
      play?.classList.add('embed__play--glow');
      window.removeEventListener('scroll', requestRender);
    }

    function render() {
      ticking = false;
      if (!done) {
        // Forward only: scrolling back up never rewinds the fall.
        maxProgress = Math.max(maxProgress, progress());
        const frame = Math.round(Math.min(1, Math.max(0, maxProgress)) * (total - 1));
        if (frame >= exitFrame()) play?.classList.add('embed__play--glow');
        if (maxProgress >= 1) finish();
        else {
          const img = nearestLoaded(frame);
          if (img) draw(img);
          return;
        }
      }
      if (isReady(empty)) draw(empty);
    }

    function requestRender() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    }

    // The story starts with the lit cigarette in the hand, and the play button off.
    scene.dataset.playing = '';
    play?.classList.remove('embed__play--glow');
    loadEnds();
    resizeCanvas();

    const intents = ['scroll', 'wheel', 'touchstart', 'pointerdown', 'keydown'];
    const start = () => {
      intents.forEach((type) => window.removeEventListener(type, start));
      loadAll();
    };
    if (window.scrollY > 0) start();
    else intents.forEach((type) => window.addEventListener(type, start, { passive: true }));

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', () => {
      resizeCanvas();
      requestRender();
    });
    desktop.addEventListener('change', () => {
      loadEnds();
      if (!done) loadAll();
      resizeCanvas();
    });
    requestRender();
  }
</script>

<style>
  /* No z-index or isolation here: a stacking context would cut the scene off from the page it blends with. */
  .bridge {
    position: relative;
    height: 0;
  }

  /* Hangs from the bridge: the hand right under the tagline, the fall behind the Music header and covers.
     z-index 1: above the hero (its fog would cover it), below Music's content (z-index 2). Never catches clicks. */
  .scene {
    position: absolute;
    top: var(--scene-top);
    right: var(--gutter);
    z-index: 1;
    /* The smoke rises over the tagline; the hand sits right under it */
    --scene-top: -6.5rem;
    width: min(360px, 100% - 2 * var(--gutter));
    aspect-ratio: 480 / 600;
    pointer-events: none;
    /* The frame background is a touch darker than the page in every channel: `lighten` keeps the
       lighter pixel, so the background disappears and only the cream line and the ember remain. */
    mix-blend-mode: lighten;
    /* Fades: top (smoke), bottom (the cigarette dissolves as it keeps falling), sides (blend into the page) */
    mask-image:
      linear-gradient(to bottom, transparent, black 12%, black 60%, transparent 92%),
      linear-gradient(to right, transparent, black 20%, black 88%, transparent);
    mask-composite: intersect;
  }

  @media (min-width: 48rem) {
    .scene {
      --scene-top: -5.5rem;
      width: min(880px, 80%);
      aspect-ratio: 900 / 620;
      /* At this size the box reaches below the player: end the bottom fade earlier so nothing peeks out. */
      mask-image:
        linear-gradient(to bottom, transparent, black 4%, black 50%, transparent 80%),
        linear-gradient(to right, transparent, black 20%, black 88%, transparent);
    }
  }

  .scene img,
  .scene canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* With JS the canvas tells the story from the start: hide the empty-hand default underneath. */
  .scene[data-playing] picture {
    visibility: hidden;
  }
</style>
