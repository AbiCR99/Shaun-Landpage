---
// The address never appears in the HTML as plain text: the parts are stored reversed
// and joined with JS on the visitor's browser. Simple bots that scrape HTML don't get it.
interface Props {
  email: string | null;
  /** Pre-filled subject of the mailto: link */
  subject?: string;
}

const { email, subject } = Astro.props;
const reverse = (s: string) => [...s].reverse().join('');
const [user, domain] = email ? email.split('@') : [];
---

{
  email ? (
    <a class="email" href="#booking" data-u={reverse(user)} data-d={reverse(domain)} data-s={subject}>
      {user} [at] {domain.replace(/\./g, ' [dot] ')}
    </a>
  ) : (
    <span class="pending">[EMAIL PENDIENTE]</span>
  )
}

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.email[data-u]').forEach((a) => {
    const reverse = (s: string) => [...s].reverse().join('');
    const address = `${reverse(a.dataset.u!)}@${reverse(a.dataset.d!)}`;
    const subject = a.dataset.s ? `?subject=${encodeURIComponent(a.dataset.s)}` : '';
    a.href = `mailto:${address}${subject}`;
    a.textContent = address;
  });
</script>

<style>
  .email {
    font-family: var(--font-mono);
    text-underline-offset: 0.25em;
    text-decoration-color: var(--blue-400);
  }

  .email:hover {
    text-decoration-color: var(--moon-100);
  }
</style>
