# Web3Forms access key (https://web3forms.com). Copy this file to .env and fill it in.
# It's public by design (it only allows sending to the email it was created for),
# but we keep it out of the code so it can change without touching components.
PUBLIC_WEB3FORMS_KEY=

# Public URL of the site, without a trailing slash (e.g. https://shaunnolanh.com).
# Leave empty on Vercel until the real domain exists: the build then uses Vercel's
# production URL (VERCEL_PROJECT_PRODUCTION_URL). Locally it falls back to http://localhost:4321.
SITE_URL=
